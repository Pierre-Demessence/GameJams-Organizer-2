# Database
DATABASE_URL="postgresql://gamejams:gamejams@localhost:5432/gamejams"
POSTGRES_USER="gamejams"
POSTGRES_PASSWORD="gamejams"
POSTGRES_DB="gamejams"

# Auth.js — REQUIRED: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Discord OAuth (optional) — https://discord.com/developers/applications
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Platform admin — email of the user seeded with the Site Admin staff role
STAFF_ADMIN_EMAIL=""

# Initial admins — comma-separated emails promoted to Site Admin on sign-in.
# Bootstraps the first admin on a fresh (prod) database without seeding.
INITIAL_ADMIN_EMAILS=""
